---
// src/components/FeaturedArticleCard.astro
const {
  title = "Название статьи",
  description = "Описание статьи",
  image = "/placeholder.jpg",
  link = "#",
  buttonText = "Читать далее"
} = Astro.props;
---

<div class="col-md-6 featured-article-card">
  <div class="card">
    <img src={image} class="card-img-top" alt={title} loading="lazy" />
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-text">{description}</p>
      <a href={link} class="btn btn-primary">{buttonText}</a>
    </div>
  </div>
</div>

<style lang="scss">
.featured-article-card {
  margin-bottom: 30px;
  
  .card {
    background: #F8E1C4;
    color: #5A3E2B;
    border-radius: 15px;
    box-shadow: none;
    transition: transform 0.3s, box-shadow 0.3s;
    
    &:hover {
      transform: translateY(-5px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }
  }
  
  .card-img-top {
    height: 200px;
    object-fit: cover;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
  }
  
  .btn-primary {
    background-color: #9C4A36;
    border: none;
    padding: 10px 25px;
    font-size: 1.1rem;
    transition: background-color 0.3s, transform 0.3s;
    
    &:hover {
      background-color: #7F3A2A;
      transform: scale(1.05);
    }
  }

  @media (max-width: 768px) {
    .card .btn-primary,
    .card .card-text {
      display: none;
    }
    
    .card {
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      
      &:active {
        transform: scale(0.98);
      }
    }
    
    .card::after {
      content: "Нажмите, чтобы прочитать";
      display: block;
      text-align: center;
      font-size: 1.4rem;
      color: #9C4A36;
      font-weight: bold;
      padding: 10px 0;
      background: rgba(255, 255, 255, 0.2);
      border-bottom-left-radius: 15px;
      border-bottom-right-radius: 15px;
    }
  }
}
</style>