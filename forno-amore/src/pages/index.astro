---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import RecipeCard from '../components/RecipeCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Button from '../components/buttons.astro';
---

<Layout activeLink="/">
    <Hero 
    title="Рецепты итальянской кухни от Forno & Amore — готовим дома с любовью!"
    subtitle="Простые и вкусные рецепты итальянской кухни. Пошаговые инструкции, советы от шеф-поваров и вдохновение для ваших кулинарных экспериментов."
    buttonText="Начать готовить"
    buttonLink="/recipes"
  />
  <WhyChooseUs/>

  
<div class="container py-5">
  <h2 class="section-title text-center">Популярные рецепты</h2>
  <div class="row">
    <RecipeCard 
      title="Пицца Маргарита" 
      description="Классическая итальянская пицца с томатами, базиликом и моцареллой."
      image="/margarita.jpg"
      link="/recipes/margarita"
    >
      <Button slot="button" text="Читать рецепт" href="/recipes/margarita" type="primary" />
    </RecipeCard>
    
    <RecipeCard 
      title="Паста Карбонара" 
      description="Нежная паста с соусом из яиц, пармезана и гуанчиале. Идеальное блюдо для ужина."
      image="/rf.jpg"
      link="/recipes/margarita"
    >
      <Button slot="button" text="Читать рецепт" href="/recipes/margarita" type="primary" />
    </RecipeCard>
    <RecipeCard 
      title="Ризотто с грибами" 
      description="Ароматное ризотто с грибами и пармезаном. Настоящее итальянское блюдо для гурманов."
      image="/rizo.jpg"
      link="/recipes/margarita"
    >
      <Button slot="button" text="Читать рецепт" href="/recipes/margarita" type="primary" />
    </RecipeCard>
    <RecipeCard 
      title="Тирамису" 
      description="Знаменитый итальянский десерт с кофе и mascarpone. Легкий и воздушный.."
      image="/t.jpg"
      link="/recipes/margarita"
    >
      <Button slot="button" text="Читать рецепт" href="/recipes/margarita" type="primary" />
    </RecipeCard>
    <RecipeCard 
      title="Лазанья" 
      description="Слоёная паста с мясным соусом, бешамель и сыром. Классика итальянской кухни."
      image="/la.jpg"
      link="/recipes/margarita"
    >
      <Button slot="button" text="Читать рецепт" href="/recipes/margarita" type="primary" />
    </RecipeCard>
    <RecipeCard 
      title="Брускетта" 
      description="Итальянская закуска с помидорами, базиликом и оливковым маслом. Просто и вкусно."
      image="/12.jpg"
      link="/recipes/margarita"
    >
      <Button slot="button" text="Читать рецепт" href="/recipes/margarita" type="primary" />
    </RecipeCard>
    
  </div>
</div>

<div class="decorative-line"></div>
    <div class="container py-5">
  <h2 class="section-title text-center">Популярные статьи</h2>
  <div class="row">
    <ArticleCard 
      title="История пиццы: как появилась пицца" 
      description="Узнайте, как пицца стала одним из самых популярных блюд в мире"
      image="/mar.jpg"
      link="/articles/pizza-history"
    >
      <Button slot="button" text="Читать статью" href="/articles/pizza-history" type="primary" />
    </ArticleCard>
    <ArticleCard 
      title="Тесто для настоящей Итальянской пиццы" 
      description="Классический рецепт идеального теста для пиццы"
      image="/тесто.jpg"
      link="/articles/pizza-history"
    >
      <Button slot="button" text="Читать статью" href="/articles/pizza-history" type="primary" />
    </ArticleCard>
    <ArticleCard 
      title="Как выбрать идеальный сыр для пиццы" 
      description="5 лучших сыров для пиццы и секреты идеального сырного покрытия."
      image="/cheese.jpg"
      link="/articles/pizza-history"
    >
      <Button slot="button" text="Читать статью" href="/articles/pizza-history" type="primary" />
    </ArticleCard>
    <ArticleCard 
      title="Как выбрать печь для пиццы" 
      description="Как выбрать идеальную печь для пиццы: разбираем все типы и даем рекомендации"
      image="/печь.jpg"
      link="/articles/pizza-history"
    >
      <Button slot="button" text="Читать статью" href="/articles/pizza-history" type="primary" />
    </ArticleCard>
    <ArticleCard 
      title="Скоро.." 
      description="Скоро.."
      image="/img/mar.jpg"
      link="/articles/pizza-history"
    >
      <Button slot="button" text="Читать статью" href="/articles/pizza-history" type="primary" />
    </ArticleCard>
    <ArticleCard 
      title="Скоро.." 
      description="Скоро.."
      image="/img/mar.jpg"
      link="/articles/pizza-history"
    >
      <Button slot="button" text="Читать статью" href="/articles/pizza-history" type="primary" />
    </ArticleCard>
    
  </div>
  
</Layout>